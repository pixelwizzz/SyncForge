# ──────────────────────────────────────────────────────────
#  SyncForge Frontend Environment Variables
# ──────────────────────────────────────────────────────────
#  All Vite-exposed vars must start with VITE_
#  Copy this to .env.local and fill in your Clerk keys.
# ──────────────────────────────────────────────────────────

# Backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:3000

# Clerk publishable key (safe for client-side)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# WebSocket URL (defaults to VITE_API_URL if omitted)
# VITE_WS_URL=http://localhost:3000
